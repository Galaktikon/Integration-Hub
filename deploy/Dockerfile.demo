FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /source
COPY . .
RUN dotnet restore src/IntegrationHub.DemoSystems/IntegrationHub.DemoSystems.csproj
RUN dotnet publish src/IntegrationHub.DemoSystems/IntegrationHub.DemoSystems.csproj -c Release --no-restore -o /out

FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
COPY --from=build /out .
ENV ASPNETCORE_URLS=http://+:8081
EXPOSE 8081
ENTRYPOINT ["dotnet", "IntegrationHub.DemoSystems.dll"]
